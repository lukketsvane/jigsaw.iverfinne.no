{
  "schema_version": "2.0.0",
  "domain": "nordic_helleristninger",
  "description": "Hierarchical motif taxonomy and scientific period/layer specification for Norwegian and Swedish prehistoric rock carvings (helleristninger / hällristningar), preserving v1.0.0 families/classes and adding chronological, tradition, and multi-layer SVG documentation metadata.",
  "quarantine_policy": {
    "exclude_media_types": [
      "painted_photo"
    ],
    "rule": "Trace what is carved, not the modern paint. All painted_photo records are quarantined at archive ingestion and strictly excluded from scientific tracing.",
    "allowed_traceable_media_types": [
      "bw_tracing",
      "svg_vector",
      "rubbing_frottage",
      "rti_3d"
    ]
  },
  "periods": {
    "stone_age_hunter": {
      "label": "Stone Age Hunter-Gatherer Tradition (Veideristninger)",
      "norwegian_term": "Veideristninger / Fangstfolkets bergkunst",
      "swedish_term": "Nordsvenska hällristningar / Jägare-samlartradition",
      "chronological_span_bce": [
        -7000,
        -1800
      ],
      "dating_basis": [
        "Post-glacial isostatic shore-displacement curves (e.g. Alta Phases I-V, Helskog 1988, 2012; Vingen, Lødøen & Mandt 2010, 2012)",
        "Stratigraphic superposition & stylistic seriation (Gjessing 1932, 1936; Hallström 1938, 1960)"
      ],
      "core_regions": [
        "Alta (Finnmark, NO)",
        "Nämforsen (Ångermanland, SE)",
        "Vingen (Vestland, NO)",
        "Trøndelag northern sites (Bøla, Evenhus, Holtås, Bardal lower phases, NO)",
        "Nordland (Leiknes, Rødøy, Skjomen, NO)"
      ],
      "characteristic_motifs": [
        "reindeer",
        "elk_moose",
        "bear",
        "whale_cetacean",
        "fish",
        "skier",
        "stone_age_boat",
        "quadruped_other"
      ],
      "key_literature_ids": [
        "helskog_1988",
        "helskog_2012",
        "hallstrom_1938",
        "hallstrom_1960",
        "gjessing_1932",
        "gjessing_1936",
        "lodoen_mandt_2010",
        "lodoen_mandt_2012"
      ]
    },
    "bronze_age_agrarian": {
      "label": "Bronze Age Agrarian Tradition (Jordbruksristninger)",
      "norwegian_term": "Jordbruksristninger",
      "swedish_term": "Sydskandinaviska hällristningar / Bronsålderstradition",
      "chronological_span_bce": [
        -1800,
        -500
      ],
      "dating_basis": [
        "Bronze artefact typology (curved bronze lurs, socketed/flanged axes, horned helmets, Hjortspring-precursor ship prows; Marstrander 1963; Kaul 1998; Ling 2008)",
        "Shoreline elevation models in Bohuslän and Østfold (Ling 2008; Vogt 2011)"
      ],
      "core_regions": [
        "Bohuslän / Tanum (Västra Götaland, SE)",
        "Østfold (Sarpsborg, Fredrikstad, Skjeberg, Halden, NO)",
        "Rogaland (Austre Åmøy, Revheim, NO)",
        "Trøndelag agrarian sites (Leirfall, Hegra, Bardal upper phases, NO)",
        "Östergötland (Himmelstalund), Skåne (Kivik, Simrishamn), Uppland (Boglösa), SE"
      ],
      "characteristic_motifs": [
        "bronze_age_ship",
        "sun_wheel",
        "footprint",
        "horse",
        "lur_blower",
        "acrobat_dancer",
        "rider",
        "chariot_plough",
        "axe_weapon",
        "tree"
      ],
      "key_literature_ids": [
        "marstrander_1963",
        "vogt_2011",
        "ling_2008",
        "milstreu_prohl_1996",
        "bertilsson_1987",
        "kaul_1998",
        "sognnes_2001"
      ]
    },
    "mixed": {
      "label": "Multi-Period / Transitional Panel",
      "norwegian_term": "Flerperiodefelt",
      "swedish_term": "Flerperiodslokal",
      "chronological_span_bce": [
        -5000,
        500
      ],
      "dating_basis": [
        "Panels exhibiting superimposed or co-occurring hunter-gatherer and agrarian carvings (e.g. Bardal, Hell, Nämforsen Bronze Age ships alongside Stone Age elks, Alta Phase IV-V)"
      ],
      "core_regions": [
        "Bardal (Steinkjer, Trøndelag, NO)",
        "Nämforsen (Ångermanland, SE)",
        "Alta late phases (Finnmark, NO)"
      ],
      "characteristic_motifs": [
        "elk_moose",
        "bronze_age_ship",
        "stone_age_boat",
        "anthropomorph",
        "multi_motif_panel"
      ],
      "key_literature_ids": [
        "gjessing_1936",
