        "helskog_2012"
      ]
    },
    "unknown": {
      "label": "Undetermined / Unverified Chronology",
      "norwegian_term": "Ubestemt datering",
      "swedish_term": "Obestämd datering",
      "chronological_span_bce": null,
      "dating_basis": [
        "Insufficient diagnostic typology, elevation metadata, or archival provenance to assign period."
      ],
      "core_regions": [],
      "characteristic_motifs": [
        "unclassified_motif",
        "geometric_spiral"
      ],
      "key_literature_ids": []
    }
  },
  "scientific_svg_layers": {
    "figures": {
      "svg_group_id": "figures",
      "description": "Primary closed solid exterior silhouette <path> of the carved figure, preserved at true physical scale (mm) when calibrated or documented pixel-space when uncalibrated.",
      "required": true,
      "styling": "solid fill, closed CCW simple polygon"
    },
    "cup_marks": {
      "svg_group_id": "cup_marks",
      "description": "Isolated circular pecked depressions (skålgroper / älvkvarnar) adjacent to or associated with the figure.",
      "required": false,
      "styling": "separate circular/elliptical <path> or <circle> elements"
    },
    "cracks": {
      "svg_group_id": "cracks",
      "description": "Linear geological fissures, glacial striations, and bedrock fractures excluded from the archaeological figure silhouette.",
      "required": false,
      "styling": "open stroke <path> elements clearly distinguished from pecked grooves"
    },
    "uncertain": {
      "svg_group_id": "uncertain",
      "description": "Weathered, exfoliated, or low-confidence pecked edges where boundary continuity is uncertain.",
      "required": false,
      "styling": "stroke-dasharray=\"2 2\" open/dashed <path> elements"
    },
    "scale_bar": {
      "svg_group_id": "scale_bar",
      "description": "Verified physical metric scale bar (e.g. 100 mm / 10 cm) included whenever scale_calibrated is true.",
      "required": false,
      "styling": "labeled <rect> / <line> + <text> group present only when physical scale is calibrated"
    }
  },
  "render_styles": {
    "solid_pecked": "Filled pecked figure (e.g. Bronze Age ships/animals, filled Stone Age fauna); close micro-gaps, fill internal micro-holes, smooth cleanly.",
    "outline_enclosed": "Contour/outline-carved figure (e.g. Stone Age contour reindeer, elk, whales, boats); close small outline breaks and flood-fill enclosed interior into a solid silhouette.",
    "linear_motif": "Stick/line carving (e.g. Bronze Age ships with crew strokes, warriors, skiers, sun crosses, chariots); apply controlled morphological stroke-envelope thickening and rounded closing into a single connected laser-cuttable exterior silhouette."
  },
  "jigsaw_tiers": {
    "A_ready": "Solid iconic silhouette with strong necks that survives conservative laser kerf/neck erosion without needing heavy thickening.",
    "B_thickened": "Recognizable linear or thin-appendage motif made laser-cuttable via controlled stroke-envelope thickening and surviving kerf/neck erosion.",
    "C_fragile_or_review": "Motif retained separately for manual Figma cleanup or visual review (e.g., borderline thin necks, partial contour, or ambiguous multi-figure fragment)."
  },
