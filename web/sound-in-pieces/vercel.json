{
 "outputDirectory": "public",
 "headers": [
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/manifest.webmanifest",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/manifest+json"
    }
   ]
  },
  {
   "source": "/(js|data|models)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/(img|fonts|media|icons|splash)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  }
 ]
}